      ]
    },
    {
      "type": "stat",
      "title": "Sağlıklı Vitess Tablet Sayısı",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "targets": [
        { "expr": "count(kube_pod_status_ready{pod=~'.*-vttablet-.*'})", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "VTGate Sorgu Trafiği (QPS)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
