    {
      "type": "timeseries",
      "title": "Hata Oranı (HTTP Status Codes 4xx / 5xx)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(rate(nginx_http_requests_total{status=~'5..'}[1m]))", "legendFormat": "5xx Hataları", "refId": "A" },
        { "expr": "sum(rate(nginx_http_requests_total{status=~'4..'}[1m]))", "legendFormat": "4xx Hataları", "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Uygulama Pod CPU Kullanımı vs Requests",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum(node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate{pod=~'app-deployment-.*'}) by (pod)", "legendFormat": "{{pod}} CPU", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Uygulama Pod Bellek (RAM) Kullanımı vs Limits",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(container_memory_working_set_bytes{pod=~'app-deployment-.*', container!=''}) by (pod)", "legendFormat": "{{pod}} RAM", "refId": "A" }
