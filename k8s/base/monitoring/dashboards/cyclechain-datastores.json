  "liveNow": false,
  "panels": [
    {
      "type": "gauge",
      "title": "Redis Önbellek İsabet Oranı (Cache Hit Ratio %)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "(sum(rate(redis_keyspace_hits_total[5m])) / (sum(rate(redis_keyspace_hits_total[5m])) + sum(rate(redis_keyspace_misses_total[5m])))) * 100", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 50 }, { "color": "green", "value": 80 }] } } }
    },
    {
      "type": "stat",
      "title": "MySQL Aktif Bağlantı Sayısı",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "mysql_global_status_threads_connected", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Redis İstemci Bağlantıları (Connected Clients)",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "redis_connected_clients", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Redis Kullanılan RAM (MB)",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "redis_memory_used_bytes / 1024 / 1024", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "MySQL Sorgu Trafiği (QPS) ve Yavaş Sorgular (Slow Queries)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        { "expr": "rate(mysql_global_status_queries[1m])", "legendFormat": "Sorgu QPS", "refId": "A" },
        { "expr": "rate(mysql_global_status_slow_queries[1m])", "legendFormat": "Yavaş Sorgular", "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Redis Cache Hit vs Miss & Eviction Hızı",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "expr": "rate(redis_keyspace_hits_total[1m])", "legendFormat": "Cache Hits", "refId": "A" },
        { "expr": "rate(redis_keyspace_misses_total[1m])", "legendFormat": "Cache Misses", "refId": "B" },
        { "expr": "rate(redis_evicted_keys_total[1m])", "legendFormat": "Evictions", "refId": "C" }
      ]
    },
    {
      "type": "timeseries",
      "title": "MySQL Ağ Trafiği (Received / Sent Bytes)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        { "expr": "rate(mysql_global_status_bytes_received[1m])", "legendFormat": "Gelen Veri (Bytes/s)", "refId": "A" },
        { "expr": "rate(mysql_global_status_bytes_sent[1m])", "legendFormat": "Giden Veri (Bytes/s)", "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Redis Ağ Trafiği (In / Out Bytes)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        { "expr": "rate(redis_net_input_bytes_total[1m])", "legendFormat": "Gelen Veri (Bytes/s)", "refId": "A" },
        { "expr": "rate(redis_net_output_bytes_total[1m])", "legendFormat": "Giden Veri (Bytes/s)", "refId": "B" }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
